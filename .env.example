# Local development settings. Copy to .env (which git ignores) and adjust.
# The Makefile loads .env and passes it to every command. No quotes: make reads
# this file too, and would keep them as part of the value.

# Postgres from docker compose, on 5433 because a local install often holds 5432.
DATABASE_URL=

# Kafka from docker compose. Comma-separated if there is more than one broker.
KAFKA_BROKERS=localhost:9092

# The API: where it listens, and where clients such as the demo reach it.
API_ADDR=:8080
API_URL=http://localhost:8080

# MockBank, the simulated payment rail. Compose runs it on 8081; the worker and
# the sender call it there.
PROVIDER_URL=http://localhost:8081
MOCKBANK_WEBHOOK_SECRET=
CUSTOMER_WEBHOOK_URL=
CUSTOMER_WEBHOOK_SECRET=

# Only for `make mock-bank`, which runs MockBank from source instead of in
# compose. Compose sets its own copies of these in docker-compose.yml.
MOCKBANK_ADDR=:8081
WEBHOOK_URL=http://localhost:8080/v1/webhooks/mockbank
SETTLE_DELAY=2s

# The card network simulator (`make mock-network`, or compose profile `network`). It
# calls the issuer, which is the API. NETWORK_SECRET: at least 32 random bytes, and
# required by the API too, which verifies the network's signatures with it.
NETWORK_ADDR=:8082
ISSUER_URL=http://localhost:8080
NETWORK_SECRET=
NETWORK_AUTH_DEADLINE=2s
NETWORK_STANDIN_LIMIT=10000
NETWORK_SEED=1

# The hold expirer (`make hold-expirer`): approved card holds that never clear are
# released after this many days. Interval 0 runs one pass and exits.
HOLD_EXPIRY_DAYS=7
HOLD_EXPIRY_INTERVAL=1m

# Clearing (`make clearing`): NETWORK_URL is where the simulator serves
# GET /clearing?date=. A clearing above its hold by more than this percentage of the
# authorized amount is still posted, and flagged over_tolerance.
NETWORK_URL=http://localhost:8082
CLEARING_OVER_TOLERANCE_PCT=20
